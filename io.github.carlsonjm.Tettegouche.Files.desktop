[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Open folders in Tettegouche's Files
Exec=tettegouche --folder %u
Icon=co.goodinput.tettegouche-files
Terminal=false
NoDisplay=true
MimeType=inode/directory;
Categories=System;FileManager;
X-KDE-Protocols=KIO
StartupNotify=false
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
